  "source": {
    "title": "Polymarket API rate limits",
    "url": "https://docs.polymarket.com/api-reference/rate-limits",
    "notes": "Current Data API v2 limits; retired v1 routes are excluded. Cloudflare throttles on sliding windows."
  },
  "families": {
    "gamma": {
      "base_url": "https://gamma-api.polymarket.com",
      "auth": "none",
      "limits": [
        {"scope": "general", "requests": 4000, "window_seconds": 10},
        {"scope": "/events", "requests": 500, "window_seconds": 10},
        {"scope": "/markets", "requests": 300, "window_seconds": 10},
        {"scope": "/comments", "requests": 200, "window_seconds": 10}
      ]
    },
    "data": {
      "base_url": "https://data-api.polymarket.com",
      "auth": "none",
      "limits": [
        {"scope": "general", "requests": 800, "window_seconds": 10},
        {"scope": "/v2/trades", "requests": 300, "window_seconds": 10},
        {"scope": "/v2/positions", "requests": 200, "window_seconds": 10},
        {"scope": "/v2/activity", "requests": 200, "window_seconds": 10},
        {"scope": "/v2/positions/combos", "requests": 200, "window_seconds": 10},
        {"scope": "/v2/activity/combos", "requests": 200, "window_seconds": 10},
        {"scope": "/v2/prices-history", "requests": 200, "window_seconds": 10},
        {"scope": "/v2/status", "requests": 100, "window_seconds": 10}
      ]
    },
    "clob": {
      "base_url": "https://clob.polymarket.com",
      "auth": "mixed",
      "limits": [
        {"scope": "general", "requests": 9000, "window_seconds": 10},
        {"scope": "/book", "requests": 1500, "window_seconds": 10},
        {"scope": "/midpoint", "requests": 1500, "window_seconds": 10}
      ]
    }
  }
